{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CloudCord",
  "version": "0.1.0",
  "identifier": "net.kuroneko.cloudcord",
  "build": {
    "beforeDevCommand": "npm run dev -w @cloudcord/web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build -w @cloudcord/web",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "CloudCord",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: wss:; img-src 'self' asset: data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "category": "SocialNetworking",
    "shortDescription": "Cloudflare-native community chat"
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["cloudcord"] } },
    "updater": {
      "endpoints": [
        "https://releases.example.invalid/desktop/latest/{{target}}-{{arch}}.json"
      ],
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBLIC_KEY"
    }
  }
}
