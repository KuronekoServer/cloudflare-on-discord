{
  // Merge this array into the deployed environment's Wrangler config after
  // creating cloudcord-<environment>-secrets. Never commit the actual store ID.
  "secrets_store_secrets": [
    {
      "binding": "JWT_SIGNING_KEY_SECRET",
      "store_id": "<STORE_ID>",
      "secret_name": "JWT_SIGNING_KEY",
    },
    {
      "binding": "DATA_ENCRYPTION_KEY_SECRET",
      "store_id": "<STORE_ID>",
      "secret_name": "DATA_ENCRYPTION_KEY",
    },
    {
      "binding": "LOOKUP_HMAC_KEY_SECRET",
      "store_id": "<STORE_ID>",
      "secret_name": "LOOKUP_HMAC_KEY",
    },
    {
      "binding": "TURNSTILE_SECRET_SECRET",
      "store_id": "<STORE_ID>",
      "secret_name": "TURNSTILE_SECRET",
    },
    {
      "binding": "ADMIN_BOOTSTRAP_TOKEN_SECRET",
      "store_id": "<STORE_ID>",
      "secret_name": "ADMIN_BOOTSTRAP_TOKEN",
    },
    {
      "binding": "REALTIME_API_TOKEN_SECRET",
      "store_id": "<STORE_ID>",
      "secret_name": "REALTIME_API_TOKEN",
    },
    {
      "binding": "CLOUDFLARE_BACKUP_API_TOKEN_SECRET",
      "store_id": "<STORE_ID>",
      "secret_name": "CLOUDFLARE_BACKUP_API_TOKEN",
    },
  ],
}
