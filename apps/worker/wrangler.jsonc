  "kv_namespaces": [
    {
      "binding": "PUBLIC_CACHE",
      "id": "00000000000000000000000000000001",
      "preview_id": "00000000000000000000000000000001",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "cloudcord-dev-media",
      "preview_bucket_name": "cloudcord-dev-media-preview",
    },
    {
      "binding": "RELEASES",
      "bucket_name": "cloudcord-dev-releases",
      "preview_bucket_name": "cloudcord-dev-releases-preview",
    },
  ],
  "queues": {
    "producers": [
      { "binding": "EVENT_QUEUE", "queue": "cloudcord-dev-events" },
    ],
    "consumers": [
      {
        "queue": "cloudcord-dev-events",
        "max_batch_size": 20,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "cloudcord-dev-events-dlq",
      },
    ],
  },
  "send_email": [{ "name": "EMAIL" }],
  "workflows": [
    {
      "name": "cloudcord-dev-shard-migration",
      "binding": "SHARD_MIGRATION",
      "class_name": "ShardMigrationWorkflow",
    },
    {
      "name": "cloudcord-dev-account-lifecycle",
      "binding": "ACCOUNT_LIFECYCLE",
      "class_name": "AccountLifecycleWorkflow",
    },
    {
      "name": "cloudcord-dev-backup",
      "binding": "BACKUP_WORKFLOW",
      "class_name": "BackupWorkflow",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ID_GENERATORS", "class_name": "IdGeneratorDO" },
      { "name": "GUILD_COORDINATORS", "class_name": "GuildCoordinatorDO" },
      { "name": "GUILD_PRESENCE", "class_name": "GuildPresenceDO" },
      { "name": "CHANNEL_HUBS", "class_name": "ChannelHubDO" },
      { "name": "MESSAGE_PARTITIONS", "class_name": "MessagePartitionDO" },
      { "name": "SEARCH_PARTITIONS", "class_name": "GuildSearchPartitionDO" },
      { "name": "USER_SESSIONS", "class_name": "UserSessionDO" },
      { "name": "VOICE_ROOMS", "class_name": "VoiceRoomDO" },
      { "name": "BOT_GATEWAY_SHARDS", "class_name": "BotGatewayShardDO" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "IdGeneratorDO",
        "GuildCoordinatorDO",
        "GuildPresenceDO",
        "ChannelHubDO",
        "MessagePartitionDO",
        "GuildSearchPartitionDO",
        "UserSessionDO",
        "VoiceRoomDO",
        "BotGatewayShardDO",
      ],
    },
  ],
  "triggers": { "crons": ["*/15 * * * *", "0 3 * * 0"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
