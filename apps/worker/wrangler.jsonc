{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudcord-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health", "/.well-known/*"],
  },
  "vars": {
    "ENVIRONMENT": "dev",
    "APP_NAME": "CloudCord",
    "PUBLIC_ORIGIN": "http://localhost:8787",
    "RP_ID": "localhost",
    "EMAIL_FROM": "noreply@cloudcord.invalid",
    "ACCESS_TOKEN_TTL_SECONDS": "900",
    "REFRESH_TOKEN_TTL_SECONDS": "2592000",
    "UPLOAD_FILE_LIMIT_BYTES": "52428800",
    "UPLOAD_DAILY_USER_LIMIT_BYTES": "1073741824",
    "UPLOAD_GUILD_LIMIT_BYTES": "107374182400",
    "VOICE_ROOM_LIMIT": "50",
    "VOICE_SCREEN_SHARE_LIMIT": "5",
  },
  "d1_databases": [
    {
      "binding": "IDENTITY_DB",
      "database_name": "cloudcord-dev-identity",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations/identity",
    },
    {
      "binding": "SOCIAL_DB_00",
      "database_name": "cloudcord-dev-social-00",
      "database_id": "00000000-0000-0000-0000-000000000100",
      "migrations_dir": "migrations/social",
    },
    {
      "binding": "SOCIAL_DB_01",
      "database_name": "cloudcord-dev-social-01",
      "database_id": "00000000-0000-0000-0000-000000000101",
